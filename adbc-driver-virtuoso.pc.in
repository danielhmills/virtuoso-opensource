prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: adbc-driver-virtuoso
Description: ADBC driver for OpenLink Virtuoso
URL: https://github.com/openlink/virtuoso-opensource
Version: @PACKAGE_VERSION@
Libs: -L${libdir} -lvirtadbc
Cflags: -I${includedir}
